# 相对路径以仓库根目录为基准；DATABASE_URL 目前只支持本地 SQLite 文件。
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads/inspections
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 火山方舟控制台中的推理接入点 ID，通常以 ep- 开头
ARK_MODEL=

# 视觉提供方：ark（当前可用）或 yolo（已预留，尚未加载 YOLO 运行时）
VISION_PROVIDER=ark
# TODO(YOLO)：接入本地 YOLO 时填写；当前这些值只作为预留配置，不会加载模型。
YOLO_MODEL_PATH=
YOLO_DEVICE=auto
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_INPUT_SIZE=640

# 上传与视觉稳定性限制
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
VISION_REQUEST_TIMEOUT_SECONDS=30
VISION_TOTAL_TIMEOUT_SECONDS=75
# 仅用于方舟 JSON/结构错误修正，允许 0–2 次；YOLO 不使用此项
VISION_JSON_RETRIES=2

# 可选文本模型；不配置时使用项目内置的保守规则分级和整改模板。
TEXT_API_KEY=
TEXT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
TEXT_MODEL=
TEXT_REQUEST_TIMEOUT_SECONDS=30

# 可选内部 AI 复核。只有文本模型已配置时才可启用；最多自动重做一次。
ENABLE_AI_REVIEW=false

# 公网或真实照片部署时必须同时设置。留空表示本地开放模式。
APP_ACCESS_USERNAME=
APP_ACCESS_PASSWORD=
# Docker Compose 会强制覆盖为 true；本机开放演示保持 false。
REQUIRE_ACCESS_CONTROL=false
# 单进程内按客户端限制写请求，避免重复提交和简单滥用。
WRITE_RATE_LIMIT_PER_MINUTE=30
